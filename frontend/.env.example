# Optional. Tried first, ahead of the bundled public Arc testnet endpoints.
# The app already falls back across rpc.testnet.arc.io, arc-testnet.drpc.org,
# blockdaemon and quicknode, so this is only needed for a private endpoint.
NEXT_PUBLIC_ARC_RPC_URL=

# Optional. Overrides the WorkflowRegistry address generated from contracts/exports.
# This is the only contract address the app configures; every other address is
# resolved on chain at runtime.
NEXT_PUBLIC_REGISTRY_ADDRESS=
